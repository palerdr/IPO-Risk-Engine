          "language": "sql",
          "sql": "SELECT year, SUM(in_scope) AS in_scope, SUM(matched) AS matched, 1.0 * SUM(matched) / SUM(in_scope) AS coverage FROM registry_coverage GROUP BY year ORDER BY year",
